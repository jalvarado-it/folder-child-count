{
	"name": "obsidian-folder-child-count",
	"version": "1.0.0",
	"description": "Show the number of files and subfolders contained in each folder in Obsidian's file explorer.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"install:vault": "node scripts/install.mjs",
		"checksums": "node scripts/checksums.mjs",
		"test": "vitest run",
		"test:watch": "vitest",
		"lint": "eslint ."
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin",
		"folder",
		"count"
	],
	"license": "MIT",
	"engines": {
		"node": ">=24"
	},
	"devDependencies": {
		"@eslint/js": "^9.39.4",
		"@types/node": "^24.19.2",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.0",
		"globals": "^17.6.0",
		"jiti": "^2.6.1",
		"jsdom": "^30.1.2",
		"obsidian": "^1.14.4",
		"typescript": "^5.8.3",
		"typescript-eslint": "^8.59.1",
		"vitest": "^5.0.4"
	}
}
